# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Logs (uvicorn / vite)
*.log
*.log.*

# Rule source lives in git as <CODE>_v<version>.py. Generated drafts from the
# prompt-to-rule feature are not: they arrive as a draft the user reviews and
# commits, so v1 of any code is tracked.
backend/rules/AUTO-*

# Secrets
.env
*.env.local

# Node
node_modules/
dist/
.vite/
npm-debug.log*

# Mounted CSV landing zone: keep folder shape, ignore generated CSV payloads.
# Moves to a volume mount in production - the app only ever reads from here.
mount/SourceData/**/*.csv

# Per-run execution folders: staged rule source + the exact CSVs a run read.
# Output lives on the rule_runs row; these are inputs, rebuilt by hand if lost.
Rules_Executions/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db