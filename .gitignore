# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Logs (uvicorn / vite)
*.log
*.log.*

# Rules written by the app at runtime (rules/rule_<db_id>.py). The four seed
# rules rule_1..rule_4 are tracked; anything else here is generated output.
backend/rules/rule_[0-9][0-9].py
!backend/rules/rule_[1-4].py

# Secrets
.env
*.env.local

# Node
node_modules/
dist/
.vite/
npm-debug.log*

# SourceData: keep folder shape, ignore generated CSV payloads
SourceData/**/*.csv

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db