# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Logs (uvicorn / vite)
*.log
*.log.*

# Rule source lives in git as <CODE>_v<version>.py. A rule the agent wrote is
# tracked like any other, because a rule that has been read and saved is a
# rule like any other.
backend/rules/AUTO-*

# Scratch space for a candidate rule being tested before it is saved. Each
# trial makes one folder and deletes it when it finishes, so anything left
# here is a trial that died mid-way.
mount/.trials/**

# Secrets
.env
*.env.local

# Node
node_modules/
dist/
.vite/
npm-debug.log*
*.tsbuildinfo

# The mount: external data the app reads but never owns. A volume in production,
# a generated tree in development. Keep the folder shape, ignore the payloads.
mount/SourceData/**/*.csv

# Per-run execution folders: staged rule source + the exact CSVs a run read.
# Output lives on the rule_runs row; these are inputs, rebuilt by hand if lost.
# The folder shape is kept so the layout is visible on a fresh clone.
mount/Rules_Executions/**
!mount/Rules_Executions/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db