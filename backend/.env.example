# ---------------------------------------------------------------------------
# SquareOne Holdings - Agentic Data Analytics - local development configuration
# Generated for dev. NEVER commit this file - .env is gitignored.
# ---------------------------------------------------------------------------

# --- Who this deployment audits ---------------------------------------------
# The product ships with a neutral two-client demo estate so it names nobody.
# Replace this with your own clients before going live - it is the only place
# client identity lives, and everything downstream (app bar, rule scope, the
# data landing zone, tickets) follows from it.
#
# JSON: one object per client. `code` is UPPERCASE and is what a rule run, a
# ticket and a run folder carry, so renaming a code after go-live orphans its
# history. `name` is what a human reads. `systems` is descriptive only.
#
#   CLIENT_ENTITIES=[{"code":"SQT","name":"SquareOne Technologies","systems":["ERP","HRMS"]}]
#
CLIENT_ENTITIES=[{"code":"SQT","name":"SquareOne Technologies","systems":["iPOS (SaaS)","Azure Synapse","HRMS"]},{"code":"ET","name":"EnsaanTech","systems":["iPOS","HRMS","Business Central"]}]

# --- Database (dev) --------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=SQ1_Agentic_Data_Analytics

# --- Auth ------------------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Bootstrap users. Seeded once on first start, then bcrypt-hashed into the DB.
# One account per role, so a reviewer can try each one.
ADMIN_USERNAME=admin_user
ADMIN_PASSWORD=
MANAGER_USERNAME=manager_user
MANAGER_PASSWORD=
AUDITOR_USERNAME=audit_user
AUDITOR_PASSWORD=
VIEWER_USERNAME=viewer_user
VIEWER_PASSWORD=

# Whether the sign-in screen may ADVERTISE these accounts and their passwords.
# It is a list of working passwords on the front door - turn it off for a real
# deployment. The accounts are still seeded either way.
SHOW_DEMO_ACCOUNTS=true

# --- LLM for rule generation (any OpenAI-compatible endpoint) -------------
# Leave LLM_BASE_URL empty to disable prompt -> rule generation.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# The provider's own knobs, passed through on every call. A reasoning model
# with a large thinking budget can spend minutes on one rule, so most
# deployments want to turn it down. This is not a standard parameter: an
# endpoint that does not have it answers 400, and the call is retried once
# without it, so an unfamiliar value is survivable.
#
#   LLM_EXTRA_PARAMS={"reasoning_effort": "low"}
#
LLM_EXTRA_PARAMS=

# How many times the agent may try to produce a rule that runs (1 + repairs).
LLM_MAX_ATTEMPTS=3

# How long one model call may take, in seconds.
LLM_TIMEOUT_SECONDS=300

# How long a candidate rule may run before it is abandoned, in seconds.
TRIAL_TIMEOUT_SECONDS=30

# --- Paths (defaults are correct for this layout) -------------------------
# The mount holds external data: the CSV landing zone the app reads, and the
# per-run folders it writes. A volume in production, a tree on disk in dev.
SOURCEDATA_DIR=../mount/SourceData
RUNS_DIR=../mount/Rules_Executions
RULES_DIR=./rules

# --- Rule execution guardrails --------------------------------------------
MAX_ROWS_IN_TICKET=500

# --- API ------------------------------------------------------------------
# The port the API listens on. The server, the smoke test and the Vite dev
# proxy all read this one value.
API_PORT=3000

# --- CORS (frontend dev server) -------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
