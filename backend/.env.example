# ---------------------------------------------------------------------------
# Audit Portal - local development configuration
# Generated for dev. NEVER commit this file - .env is gitignored.
# ---------------------------------------------------------------------------

# --- Who this deployment audits ---------------------------------------------
# The product ships with a neutral two-client demo estate so it names nobody.
# Replace this with your own clients before going live - it is the only place
# client identity lives, and everything downstream (app bar, rule scope, the
# data landing zone, tickets) follows from it.
#
# JSON: one object per client. `code` is UPPERCASE and is what a rule run, a
# ticket and a run folder carry, so renaming a code after go-live orphans its
# history. `name` is what a human reads. `systems` is descriptive only.
#
#   CLIENT_ENTITIES=[{"code":"SCOPE","name":"Scope Investments","systems":["ERP","HRMS"]}]
#
CLIENT_ENTITIES=[{"code":"CLIENT-A","name":"Client A","systems":["POS","Warehouse","HRMS"]},{"code":"CLIENT-B","name":"Client B","systems":["POS","HRMS","ERP"]}]

# --- Database (dev) --------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ABM_Audit_Portal

# --- Auth ------------------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Bootstrap users. Seeded once on first start, then bcrypt-hashed into the DB.
ADMIN_USERNAME=admin_user
ADMIN_PASSWORD=
AUDITOR_USERNAME=audit_user
AUDITOR_PASSWORD=

# --- LLM for rule generation (any OpenAI-compatible endpoint) -------------
# Leave LLM_BASE_URL empty to disable prompt -> rule generation.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Paths (defaults are correct for this layout) -------------------------
# The mount holds external data: the CSV landing zone the app reads, and the
# per-run folders it writes. A volume in production, a tree on disk in dev.
SOURCEDATA_DIR=../mount/SourceData
RUNS_DIR=../mount/Rules_Executions
RULES_DIR=./rules

# --- Rule execution guardrails --------------------------------------------
MAX_ROWS_IN_TICKET=500

# --- CORS (frontend dev server) -------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
